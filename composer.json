{
	"name": "funmusicplace/mirlo-subscribe",
	"description": "Development tooling only: coding standards for the Mirlo Subscribe WordPress plugin.",
	"type": "wordpress-plugin",
	"license": "AGPL-3.0-or-later",
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	}
}
